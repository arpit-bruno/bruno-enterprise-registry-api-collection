# The address of the registry, without a trailing slash.
REGISTRY_URL=

# The License Manager that this registry asks at sign-in.
LICENSE_MANAGER_URL=

# Your email and licence key on that License Manager.
LICENSE_EMAIL=
LICENSE_KEY=

# A short name in lower-case letters and digits. The collection these requests
# create is called api-check-<this name>, so two people do not collide.
MY_NAME=
